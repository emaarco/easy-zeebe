{
  "extends": [
    "bpmnlint:recommended",
    "plugin:@miragon/rules/recommended-for-automation",
    "plugin:camunda-compat/camunda-cloud-8-8"
  ],
  "moddleExtensions": {
    "zeebe": "zeebe-bpmn-moddle/resources/zeebe.json"
  },
  "rules": {
    "no-overlapping-elements": "error",
    "local/message-id": "error",
    "local/task-type": "error"
  }
}
